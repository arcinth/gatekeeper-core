<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Latest patch release on the existing 3.3.x line (was 3.3.5) - picks up
             upstream Spring Framework/Security/Boot patch-level fixes released since
             Nov 2024, including security fixes, without the API surface changes of
             moving to 3.4.x/3.5.x. -->
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.gatekeeper</groupId>
    <artifactId>gatekeeper-core</artifactId>
    <version>1.0.0</version>
    <name>gatekeeper-core</name>
    <description>GateKeeper Core - Policy-Driven Pull Request Analysis Platform</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.6.0</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <lombok.version>1.18.44</lombok.version>
        <!-- Test-scope only (Testcontainers, WireMock) - patch-level bumps within the
             existing minor line, zero product-code impact. -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <wiremock.version>3.13.1</wiremock.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <git-commit-id-plugin.version>7.0.0</git-commit-id-plugin.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <!-- 10.0.4 -> 12.1.3: the older client's NVD API 2.0 handling lacked the
             newer retry/backoff and resumable-download behavior, which combined with
             running unauthenticated (no NVD API key) against CI's ephemeral, uncached
             runners turned every run into a full from-scratch database rebuild - the
             root cause of the "OWASP Dependency-Check" job taking 5+ hours and
             ultimately failing. See the plugin <configuration> below and
             .github/workflows/backend.yml for the accompanying cache. -->
        <dependency-check-maven.version>12.1.3</dependency-check-maven.version>
        <cyclonedx-maven-plugin.version>2.8.2</cyclonedx-maven-plugin.version>
        <!-- Overrides of versions Spring Boot 3.3.13's own dependency management would
             otherwise pin, each fixing a real CVSS >= 7 finding from OWASP
             Dependency-Check with a version confirmed to exist and stay within the
             same major.minor line Boot 3.3.13 already uses (verified individually
             against Maven Central - none of these required a Spring Boot minor
             upgrade). See docs/Security-Hardening.md and CHANGELOG.md for the full
             list; dependency-check-suppression.xml documents the findings that do
             NOT yet have a compatible patched version and are suppressed instead. -->
        <tomcat.version>10.1.57</tomcat.version>
        <log4j2.version>2.25.4</log4j2.version>
        <postgresql.version>42.7.12</postgresql.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <!-- Default for the ${env.NVD_API_KEY} reference below: Maven only resolves
             ${env.X} when the OS/CI process actually has that environment variable
             set, otherwise it leaves the literal "${env.NVD_API_KEY}" text in place
             (which dependency-check would then try to use as a real API key and fail
             authentication). Declaring the same env.* property name here supplies an
             empty-string fallback so an unset key resolves to "no key" (the plugin's
             normal unauthenticated behavior) instead of a broken literal placeholder. -->
        <env.NVD_API_KEY></env.NVD_API_KEY>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <!-- In-memory token-bucket rate limiting (Milestone 10: Security Hardening).
                 Used only behind the RateLimiter abstraction (see com.gatekeeper.security.ratelimit) -
                 no other class references Bucket4j types directly. -->
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gatekeeper-core</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Generates META-INF/build-info.properties (version, build time), consumed
                         automatically by Actuator's /actuator/info (Milestone 9: Observability). -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Generates git.properties (commit hash, branch), also consumed automatically
                     by /actuator/info. failOnNoGitDirectory=false so a source build without a
                     .git directory (e.g. from a tarball) degrades gracefully rather than failing
                     the whole build over missing version metadata. -->
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id\.(abbrev|full)$</includeOnlyProperty>
                        <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <!-- Milestone 10: Security Hardening. Bound to no phase by default (see
                     <executions> below being absent) - run explicitly via
                     `mvn org.owasp:dependency-check-maven:check` in CI (.github/workflows/backend.yml),
                     not on every local `mvn package`, since a full vulnerability-database
                     download/refresh is too slow for the everyday local build loop. -->
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check-maven.version}</version>
                <configuration>
                    <!-- CVSS >= 7 (High/Critical) fails the build - see docs/Security-Hardening.md. -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- A fixed, predictable location (rather than the plugin's own default
                         under the local Maven repository) so CI can cache exactly this directory
                         across runs - see the "Cache OWASP Dependency-Check NVD database" step in
                         .github/workflows/backend.yml. Without this, every run re-downloaded the
                         entire NVD CVE database from scratch, which - combined with NVD's public
                         (no-API-key) rate limit - is what made the job take 5+ hours and eventually
                         fail. -->
                    <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
                    <!-- Skip a fresh NVD sync entirely if the cached database is less than 24h
                         old. Paired with the cache above: only the first run of a given day pays
                         the (now much cheaper, incremental) update cost, every other run that day
                         reuses it as-is. -->
                    <nvdValidForHours>24</nvdValidForHours>
                    <!-- Optional: if a repository secret named NVD_API_KEY is configured (free,
                         see https://nvd.nist.gov/developers/request-an-api-key), CI passes it
                         through this property, raising the NVD API rate limit from 5 to 50
                         requests/30s. Left unset, this resolves to an empty string, which the
                         plugin correctly treats as "no key" (its original, unauthenticated
                         behavior) - so this is additive and never required. -->
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- Sonatype OSS Index is a secondary, supplementary vulnerability
                         source (NVD above is the primary/authoritative one and the only
                         one the CVSS >= 7 policy actually depends on). Its anonymous API
                         has a low rate limit shared across every anonymous caller -
                         empirically confirmed locally: a handful of runs in one day was
                         enough to get a 401 Unauthorized, which (unlike a real
                         vulnerability finding) hard-fails the whole goal with a
                         MojoExecutionException instead of just being absent from the
                         report. CI runners share IP pools across the whole GitHub
                         Actions fleet, so this is a realistic recurring failure mode
                         there too, unrelated to this project's actual dependencies. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Accepted-risk suppressions, each documented with why no patched
                         version exists yet - see dependency-check-suppression.xml itself
                         and docs/Security-Hardening.md section 6. -->
                    <suppressionFiles>
                        <suppressionFile>dependency-check-suppression.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
            </plugin>
            <plugin>
                <!-- CycloneDX SBOM generation (Milestone 10). Also not bound to a phase -
                     run explicitly in CI via `mvn org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom`. -->
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <configuration>
                    <projectType>application</projectType>
                    <outputFormat>json</outputFormat>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
